{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Basic CloudTrail replacing CloudTrail Lake",
  "Parameters": {
    "env": {
      "Type": "String"
    },
    "CloudTrailAuditLogs": {
      "Type": "String",
      "Default": "yes"
    }
  },
  "Resources": {
    "MyBasicTrailBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "team-cloudtrail-${AWS::AccountId}-${env}"
        }
      }
    },
    "MyBasicTrailBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "MyBasicTrailBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AWSCloudTrailAclCheck",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Action": "s3:GetBucketAcl",
              "Resource": {
                "Fn::Sub": "arn:aws:s3:::${MyBasicTrailBucket}"
              }
            },
            {
              "Sid": "AWSCloudTrailWrite",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "arn:aws:s3:::${MyBasicTrailBucket}/AWSLogs/${AWS::AccountId}/*"
              },
              "Condition": {
                "StringEquals": {
                  "s3:x-amz-acl": "bucket-owner-full-control"
                }
              }
            }
          ]
        }
      }
    },
    "MyBasicTrail": {
      "Type": "AWS::CloudTrail::Trail",
      "DependsOn": ["MyBasicTrailBucketPolicy"],
      "Properties": {
        "TrailName": {
          "Fn::Sub": "team-audit-trail-${env}"
        },
        "S3BucketName": {
          "Ref": "MyBasicTrailBucket"
        },
        "IsLogging": true,
        "IncludeGlobalServiceEvents": true,
        "IsMultiRegionTrail": false
      }
    }
  }
}
