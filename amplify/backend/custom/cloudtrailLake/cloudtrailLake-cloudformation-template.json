{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Lightweight custom CloudTrail resource providing required EventDataStoreOutput",
  "Parameters": {
    "env": {
      "Type": "String"
    },
    "CloudTrailAuditLogs": {
      "Type": "String",
      "Default": "yes"
    }
  },
  "Resources": {
    "DummyEventDataStoreParam": {
      "Type": "AWS::SSM::Parameter",
      "Properties": {
        "Name": {
          "Fn::Sub": "/team/${env}/eventDataStoreOutput"
        },
        "Type": "String",
        "Value": "disabled"
      }
    }
  },
  "Outputs": {
    "EventDataStoreOutput": {
      "Description": "EventDataStoreOutput required by teamqueryLogs",
      "Value": "disabled"
    }
  }
}
